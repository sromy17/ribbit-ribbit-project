# Copy this file to .env (or export these vars in your shell) for local runs.
# This file is safe to commit because values are examples only.

# Spring profile and port
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# Database settings used by application.yml / application-local.yml
DB_URL=jdbc:postgresql://localhost:5432/ribbit-project
DB_USER=
DB_PASSWORD=

# Optional market data provider settings
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
FAUXNANCE_API_KEY=
FAUXNANCE_USE_ORDER_PRICE_FALLBACK=false

# Market data refresh and Kafka demo settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MARKET_DATA_KAFKA_ENABLED=false
MARKET_DATA_PRIORITY_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,BRK.B,AVGO,TSLA,JPM,WMT,LLY,V,ORCL,MA,XOM,COST,NFLX,JNJ,HD,PG,BAC,ABBV,CRM,CVX
MARKET_DATA_PRIORITY_POLL_MS=30000
MARKET_DATA_SECONDARY_POLL_MS=300000
MARKET_DATA_KAFKA_TOPIC=market.quotes
MARKET_DATA_KAFKA_GROUP_ID=trading-market-data
MARKET_DATA_QUOTE_CACHE_MAX_AGE_MS=1500

# Shared JWT secret used by this service to verify tokens issued by the Node auth-stub
JWT_SHARED_SECRET=

# Optional docker-compose variables
POSTGRES_DB=ribbit-project
POSTGRES_USER=
POSTGRES_PASSWORD=
