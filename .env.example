# Copy this file to .env (or export these vars in your shell) for local runs.
# This file is safe to commit because values are examples only.

# Spring profile and port
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# Database settings used by application.yml / application-local.yml
DB_URL=jdbc:postgresql://localhost:5432/ribbit-project
DB_USER=
DB_PASSWORD=

# Optional market data provider settings
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
FAUXNANCE_API_KEY=
FAUXNANCE_USE_ORDER_PRICE_FALLBACK=false

# Optional docker-compose variables
POSTGRES_DB=ribbit-project
POSTGRES_USER=
POSTGRES_PASSWORD=
