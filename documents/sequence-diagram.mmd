sequenceDiagram
    actor User as User
    participant Session
    participant TradingAccount
    participant Order
    participant Instrument
    participant Trade
    participant Holding

    User->>Session: validate()
    activate Session
    Session-->>User: accessToken
    deactivate Session

    User->>TradingAccount: viewOrders()
    activate TradingAccount
    TradingAccount-->>User: orders list
    deactivate TradingAccount

    User->>TradingAccount: submitOrder(side, type, quantity, price)
    activate TradingAccount
    TradingAccount->>Order: submit()
    activate Order
    Order->>Instrument: calculateFee()
    activate Instrument
    Instrument-->>Order: fee amount
    deactivate Instrument
    Order-->>TradingAccount: orderId, status
    deactivate Order
    TradingAccount->>TradingAccount: withdrawFunds()
    TradingAccount-->>User: order submitted
    deactivate TradingAccount

    TradingAccount->>Trade: execute trade
    activate Trade
    Trade-->>TradingAccount: tradeId, executedQty, executionPrice
    deactivate Trade

    TradingAccount->>Holding: updatePosition()
    activate Holding
    Holding-->>TradingAccount: holding updated
    deactivate Holding

    TradingAccount->>TradingAccount: depositFunds()
    
    User->>TradingAccount: viewOrders()
    activate TradingAccount
    TradingAccount-->>User: updated orders with trades
    deactivate TradingAccount
